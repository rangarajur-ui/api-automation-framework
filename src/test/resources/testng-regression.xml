<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite">
    <listeners>
        <listener class-name="tests.report.ExtentReportListener"/>
    </listeners>
    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.SmokeTests"/>
            <class name="tests.SanityTests"/>
            <class name="tests.NegativeTests"/>
            <class name="tests.CustomizationItemTests"/>
            <class name="tests.CartVariantTests"/>
            <class name="tests.CustomerDetailsTests"/>
            <class name="tests.InstructionTests"/>
            <class name="tests.RegressionTests"/>
        </classes>
    </test>
</suite>
